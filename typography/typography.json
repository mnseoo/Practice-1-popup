  "_notes": {
    "figma_typos": [
      "Mobile 24/SeBold and Desktop 48/SeBold in Figma are typos of 'SemiBold' (weight 600). Normalized here as 'semibold'.",
      "Desktop 18 sample layer names in Figma are mislabeled as '14/Medium' and '14/Regular' — the display labels confirm they are actually 18 sizes. Stored under '18' here."
    ],
    "weight_gaps": {
      "desktop_64_56": "No Medium weight — only Bold and SemiBold.",
      "desktop_20": "No Bold — only SemiBold, Medium, Regular.",
      "mobile_12_to_10": "Sizes 12 and below drop Bold — top weight is SemiBold.",
      "mobile_10": "Only Medium is defined."
    },
    "extensions": {
      "_description": "Weights extended beyond the original Figma source for project needs. Source files: Muchon Cheolgeo popup_D / popup_D-1 — heavy display weights (Bold/ExtraBold) on small mobile sizes for emphasis copy.",
      "added_2026-05-06": [
        "fontWeight.extrabold (800) added globally — Pretendard ExtraBold.",
        "mobile.22.extrabold (22/800) — high-emphasis modal title.",
        "mobile.16.bold (16/700) — primary CTA at 2XL button size.",
        "mobile.15.bold (15/700) — emphasis body copy / secondary CTA.",
        "mobile.15.extrabold (15/800) — inline emphasized fragments inside body copy.",
        "mobile.14.bold (14/700) — compact CTA inside nav / dense surfaces.",
        "mobile.14.extrabold (14/800) — news / card heading at compact size.",
        "mobile.13.bold (13/700) — small label at bold weight (warnings, FAB labels)."
